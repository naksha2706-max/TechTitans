# Security Config
# Run 'openssl rand -hex 32' to generate a secure secret key
JWT_SECRET=super_secret_jwt_key_change_me_in_production
HASH_PEPPER=super_secret_pepper_change_me_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
